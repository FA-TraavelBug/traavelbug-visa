// public/site.webmanifest
{
  "name": "Traavel Bug - Premium Visa Services",
  "short_name": "Traavel Bug",
  "description": "Professional visa assistance for international travel.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FFFFFF",
  "theme_color": "#214696",
  "dir": "ltr",
  "lang": "en-US",
  "categories": ["travel", "visa", "tourism", "travel assistance"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "apple touch icon"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-desktop.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "platform": "desktop"
    },
    {
      "src": "/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow"
    }
  ],
  "shortcuts": [
    {
      "name": "Get Visa Assistance",
      "url": "/#services",
      "description": "Apply for visa assistance"
    },
    {
      "name": "Contact Us",
      "url": "/#contact",
      "description": "Contact our team"
    }
  ],
  "related_applications": [],
  "launch_handler": {
    "route_to": "existing-client",
    "navigate_existing_client": "always"
  },
  "share_target": {
    "action": "/share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {
    "preferred_width": 400
  }
}